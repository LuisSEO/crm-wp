# Plantilla de variables de entorno.
# COPIA este archivo a ".env" y rellena tus claves reales.
# El ".env" de verdad NUNCA se sube a GitHub (está en .gitignore).
# Esta plantilla (.env.example) sí se comparte: muestra qué claves hacen falta, sin valores.

# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (puede ir al frontend, la frena el RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# Clave maestra: SOLO en el servidor, JAMÁS en el navegador. Si se filtra, rótala.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-secreta-aqui
